<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E614181C"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/overlay_card"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/overlay_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#1E2A32"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlay_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#3C4A52"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/overlay_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#3C4A52"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/overlay_release_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#1E2A32"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/overlay_reason_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="写下一句非空理由"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:minHeight="48dp"
                android:textColor="#1E2A32" />

            <Button
                android:id="@+id/overlay_release"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="应急放行 5 分钟" />

            <Button
                android:id="@+id/overlay_dismiss"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="我知道了" />

            <Button
                android:id="@+id/overlay_open_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="打开时界" />

            <Button
                android:id="@+id/overlay_open_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="系统设置" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
